[3.8115944862365723,"o","\r\n***Операции с данными***\r\n"]
[3.8338568210601807,"o","\u001b[?25l\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\u001b[18;1HУправление таблицами:\r\n<command> create_table <имя> <столбец:тип> - создать таблицу\r\n<comman"]
[3.8339452743530273,"o","d> drop_table <имя> - удалить таблицу\r\n<command> list_tables - показать все таблицы\u001b[23;1H>>> Введите команду: \u001b[?25h"]
[6.469202756881714,"o","create_tab"]
[6.491354703903198,"o","le crud_demo name:str age:int is_active:bool"]
[7.915388107299805,"o","\r\n"]
[7.931317329406738,"o","\u001b[?25lТаблица 'crud_demo' успешно создана.\u001b[26;1H>>> Введите команду: \u001b[?25h"]
[11.51094388961792,"o","insert into crud_demo values ("]
[11.522029876708984,"o","\"Sergei\", 28, true)"]
[12.40738558769226,"o","\r\n"]
